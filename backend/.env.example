# Database Connection URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./peoplepay360.db

# JWT & Authentication
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Payslip PDF Storage
PDF_STORAGE_PATH=./storage/payslips

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP Settings for Payslip Email Dispatch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
